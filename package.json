{
  "name": "@krishtz/mock-client",
  "version": "1.0.0",
  "description": "Zod-first, type-safe in-memory mock API runtime for Storybook and tests.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "zod",
    "mock",
    "api",
    "storybook",
    "testing",
    "type-safe"
  ],
  "author": "Krishna-sm",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^3.23.0 || ^4.0.0-0"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "zod": "^3.23.8"
  }
}
